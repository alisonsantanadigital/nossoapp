rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isOrgMember(orgId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/organizations/$(orgId)) &&
             request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.members;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isUser(userId);
    }

    // Organizations Collection
    match /organizations/{orgId} {
      allow create: if isAuthenticated();
      allow read: if isOrgMember(orgId);
      allow update: if isOrgMember(orgId);
    }

    // Tenant-isolated collections (require orgId)
    match /accounts/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow create: if isOrgMember(request.resource.data.orgId);
      allow update, delete: if isOrgMember(resource.data.orgId);
    }

    match /categories/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow create: if isOrgMember(request.resource.data.orgId);
      allow update, delete: if isOrgMember(resource.data.orgId);
    }

    match /transactions/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow create: if isOrgMember(request.resource.data.orgId);
      allow update, delete: if isOrgMember(resource.data.orgId);
    }

    match /bills/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow create: if isOrgMember(request.resource.data.orgId);
      allow update, delete: if isOrgMember(resource.data.orgId);
    }

    match /goals/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow create: if isOrgMember(request.resource.data.orgId);
      allow update, delete: if isOrgMember(resource.data.orgId);
    }

    match /wishlistItems/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow create: if isOrgMember(request.resource.data.orgId);
      allow update, delete: if isOrgMember(resource.data.orgId);
    }
  }
}
